print("Welcome to Treasure Island.")
print("Your mission is to find the treasure.")
cross1 = str(input("You reach a crossroad chose left or right:")).strip().lower()
if cross1 == "left":
    cross2 = input("You reach a next crossroad chose swim or wait:").strip().lower()
else:
    print("You Fall into a hole. Game Over.")
    exit()

if cross2 == "wait":
    cross3 = input("You reach a room with different colored doors chose: red or blue or yellow:").strip().lower()
