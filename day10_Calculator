calculator_ops.py
import operator

calc_keys = {
    "+": operator.add, "-": operator.sub, "*": operator.mul, "/": operator.truediv

}

def my_ops():
    print("Choose an operator:")
    for ops_symbol in calc_keys:
        print(ops_symbol)
    return input("Pick an operator: ")

