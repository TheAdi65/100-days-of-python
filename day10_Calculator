import calculator_ops
import art

print(art.logo)

def my_calculator():
    num1 = float(input("Enter the first number: "))
    should_continue = True

    while should_continue:
        user_Choice = calculator_ops.my_ops()
        num2 = float(input("Enter the second number: "))


        calculation_function = calculator_ops.calc_keys[user_Choice]
        my_result = calculation_function(num1, num2)

        print(f"Current result: {num1} {user_Choice} {num2} = {my_result}\n")

        choice = input("Would you like to continue? (Y/N): ").upper()
        if choice == "Y":   # y Y
            num1 = my_result

        else:
            should_continue = False
            print("\n" * 5)
            print("--- Memory wiped. Starting new! ---")

    return my_result


my_calculator()

# Ganz unten, flach am linken Rand:
