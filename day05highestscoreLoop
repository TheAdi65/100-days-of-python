# You are given a list of exam scores, and you have to print out the highest score from the List.
challenge_scores = [8, 65, 89, 86, 55, 91, 64, 89]

# Your code should print: 91

# step one start position 0 - first place in List
score = challenge_scores[0]

# Step two. Loop to the list
for highest_score in challenge_scores:
    if highest_score > score:
        score = highest_score

# The positon of print decide between 'print the hole list' or only 'print the result'
print("The highest score is: ", score)
